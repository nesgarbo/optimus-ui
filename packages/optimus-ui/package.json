{
    "name": "@openng/optimus-ui",
    "version": "2.0.2",
    "author": "OpenNg",
    "description": "Optimus UI is a community-maintained, MIT licensed UI library for Angular with 80+ accessible components and design-agnostic theming, including Aura, Material, Lara and Nora presets.",
    "homepage": "https://www.openng.org/",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/openng-org/optimus-ui.git",
        "directory": "packages/optimus-ui"
    },
    "bugs": {
        "url": "https://github.com/openng-org/optimus-ui/issues"
    },
    "keywords": [
        "optimus",
        "optimusui",
        "angular",
        "ui library",
        "component library",
        "material",
        "bootstrap",
        "fluent",
        "tailwind"
    ],
    "publishConfig": {
        "directory": "dist",
        "linkDirectory": false,
        "access": "public"
    },
    "schematics": "./schematics/collection.json",
    "ng-add": {
        "save": "dependencies"
    },
    "ng-update": {
        "migrations": "./schematics/migrations.json",
        "packageGroup": [
            "@openng/optimus-ui",
            "@openng/optimus-ui-locale",
            "@openng/optimus-ui-motion",
            "@openng/optimus-ui-styled",
            "@openng/optimus-ui-styles",
            "@openng/optimus-ui-tailwindcss",
            "@openng/optimus-ui-themes",
            "@openng/optimus-ui-utils"
        ]
    },
    "scripts": {
        "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
        "build:package": "pnpm run build:prebuild && ng build optimus-ui && pnpm run build:postbuild",
        "build:prebuild": "node ./scripts/prebuild.mjs",
        "build:postbuild": "node ./scripts/postbuild.mjs",
        "build:schematics": "node ./scripts/build-schematics.mjs",
        "test:schematics": "node ./scripts/build-schematics.mjs && vitest run --config vitest.schematics.config.mts",
        "dev:link": "pnpm link --global && npm link",
        "lint": "ng lint",
        "test:unit": "ng run optimus-ui:test-vitest --watch=false",
        "test:unit:watch": "ng run optimus-ui:test-vitest --watch",
        "test:unit:coverage": "ng run optimus-ui:test-vitest --watch=false --coverage"
    },
    "devDependencies": {
        "@angular-devkit/schematics": "^22.1.6",
        "@angular/build": "catalog:angular22",
        "@pdf-lib/fontkit": "^1.1.1",
        "@schematics/angular": "^22.1.6",
        "@tiptap/core": "^3.31.4",
        "@tiptap/extension-image": "^3.31.4",
        "@tiptap/extension-list": "^3.31.4",
        "@tiptap/extensions": "^3.31.4",
        "@tiptap/pm": "^3.31.4",
        "@tiptap/starter-kit": "^3.31.4",
        "@tiptap/suggestion": "^3.31.4",
        "@types/node": "^26.2.0",
        "@univerjs/preset-sheets-core": "^1.0.3",
        "@univerjs/presets": "^1.0.3",
        "@vitest/browser-playwright": "^4.1.11",
        "@vitest/coverage-v8": "^4.1.11",
        "cropperjs": "2.3.0",
        "maplibre-gl": "^6.13.0",
        "pdf-lib": "^1.17.1",
        "pdfjs-dist": "^6.4.299",
        "prosemirror-commands": "1.7.2",
        "prosemirror-dropcursor": "1.8.3",
        "prosemirror-gapcursor": "1.4.1",
        "prosemirror-history": "1.5.0",
        "prosemirror-inputrules": "1.5.1",
        "prosemirror-keymap": "1.2.3",
        "prosemirror-model": "1.25.11",
        "prosemirror-schema-list": "1.5.1",
        "prosemirror-state": "1.4.4",
        "prosemirror-tables": "1.8.5",
        "prosemirror-transform": "1.12.1",
        "prosemirror-view": "1.42.3",
        "tslib": "^2.8.1",
        "typescript": "catalog:angular22",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@angular/cdk": "catalog:angular22",
        "@angular/common": "catalog:angular22",
        "@angular/core": "catalog:angular22",
        "@angular/forms": "catalog:angular22",
        "@angular/platform-browser": "catalog:angular22",
        "@angular/router": "catalog:angular22",
