{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "./out-tsc/app"
    },
    "include": [
        "src/**/*.ts",
        "../../packages/optimus-ui*/src/**/*.ts",
        "../../packages/optimus-ui*/types/**/*.ts",
        "../../packages/optimus-ui-themes/tokens.ts",
        "../../packages/optimus-ui/src/**/*.d.ts"
    ],
    "exclude": [
