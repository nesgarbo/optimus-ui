{
    "name": "docs",
    "private": true,
    "version": "2.0.2",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "start:ssr": "ng serve --configuration=development-ssr",
        "build": "pnpm --filter @openng/optimus-ui-themes build && npm run build:apidoc && npm run build:democode && npm run build:llm-docs && npm run build:routes && npm run build:sitemap && ng build",
        "build:apidoc": "node scripts/build-apidoc.mjs",
        "build:routes": "node scripts/build-routes.mjs",
        "build:sitemap": "node scripts/build-sitemap.mjs",
        "build:llm-docs": "node scripts/build-llm-docs.mjs",
        "build:democode": "node scripts/build-demo-code.mjs",
        "build:docs": "npm run build:apidoc && npm run build:democode && npm run build:llm-docs && npm run build:routes && npm run build:sitemap && npm run test:democode && npm run test:stackblitz",
        "test:democode": "node scripts/test-demo-code.mjs",
        "test:stackblitz": "node scripts/test-stackblitz-e2e.mjs --all"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/openng-org/optimus-ui.git",
        "directory": "apps/docs"
    },
    "devDependencies": {
        "@angular/cdk": "catalog:angular22",
        "@angular/ssr": "catalog:angular22",
        "@docsearch/css": "^5.1.2",
        "@docsearch/js": "^5.1.2",
        "@openng/icons": "catalog:",
        "@openng/optimus-ui": "workspace:*",
        "@openng/optimus-ui-themes": "workspace:*",
        "@pdf-lib/fontkit": "catalog:libs",
        "@stackblitz/sdk": "1.11.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@tiptap/core": "catalog:libs",
        "@tiptap/extension-image": "catalog:libs",
        "@tiptap/extension-list": "catalog:libs",
        "@tiptap/extensions": "catalog:libs",
        "@tiptap/pm": "catalog:libs",
        "@tiptap/starter-kit": "catalog:libs",
        "@tiptap/suggestion": "catalog:libs",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.4",
        "@univerjs/preset-sheets-core": "catalog:libs",
        "@univerjs/presets": "catalog:libs",
        "chart.js": "catalog:libs",
        "cropperjs": "catalog:libs",
        "express": "^5.2.1",
        "glob": "catalog:",
        "maplibre-gl": "catalog:libs",
        "pdf-lib": "catalog:libs",
        "pdfjs-dist": "catalog:libs",
        "prismjs": "^1.30.0",
        "quill": "catalog:libs",
        "rxjs": "~7.8.2",
        "tailwindcss": "^4.3.3",
        "tslib": "^2.8.1",
        "typedoc": "catalog:"
    },
    "dependencies": {
        "@openng/optimus-ui-tailwindcss": "workspace:*",
        "prosemirror-commands": "catalog:libs",
        "prosemirror-dropcursor": "catalog:libs",
        "prosemirror-gapcursor": "catalog:libs",
        "prosemirror-history": "catalog:libs",
        "prosemirror-inputrules": "catalog:libs",
        "prosemirror-keymap": "catalog:libs",
        "prosemirror-model": "catalog:libs",
        "prosemirror-schema-list": "catalog:libs",
        "prosemirror-state": "catalog:libs",
        "prosemirror-tables": "catalog:libs",
        "prosemirror-transform": "catalog:libs",
        "prosemirror-view": "catalog:libs"
    }
}
