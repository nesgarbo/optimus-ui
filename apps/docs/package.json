{
    "name": "docs",
    "private": true,
    "version": "2.0.2",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "start": "vite --port 4200",
        "build": "vite build && node scripts/postbuild.mjs",
        "preview": "vite preview",
        "lint": "eslint .",
        "build:apidoc": "node scripts/build-apidoc.mjs",
        "build:sitemap": "node scripts/build-sitemap.mjs",
        "build:llm-docs": "node scripts/build-llm-docs.mjs",
        "build:democode": "node scripts/build-demo-code.mjs",
        "build:component-index": "node scripts/build-component-index.mjs",
        "build:docs": "npm run build:apidoc && npm run build:democode && npm run build:llm-docs && npm run build:changelog && npm run build:issues && npm run build:component-index && npm run build:sitemap && npm run test:democode && npm run test:stackblitz",
        "test:democode": "node scripts/test-demo-code.mjs",
        "test:stackblitz": "node scripts/test-stackblitz-e2e.mjs --all",
        "build:changelog": "node scripts/build-changelog.mjs",
        "build:issues": "node scripts/build-issue-counts.mjs"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/openng-org/optimus-ui.git"
    },
    "dependencies": {
        "@openng/optimus-ui-tailwindcss": "workspace:*",
        "@tailwindcss/vite": "^4.3.3",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@analogjs/platform": "^2.7.2",
        "@analogjs/router": "^2.7.2",
        "@analogjs/vite-plugin-angular": "^2.7.2",
        "@angular/cdk": "catalog:angular22",
        "@angular/platform-server": "catalog:angular22",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@openng/icons": "catalog:",
        "@openng/optimus-ui": "workspace:*",
        "@openng/optimus-ui-themes": "workspace:*",
        "@stackblitz/sdk": "1.11.1",
        "@types/node": "^26.2.0",
        "beasties": "^0.5.4",
        "chart.js": "4.5.1",
        "front-matter": "^4.0.2",
        "marked": "^18.0.12",
        "marked-gfm-heading-id": "^4.1.4",
        "marked-highlight": "^2.2.4",
        "marked-mangle": "^1.1.13",
        "marked-shiki": "^1.2.1",
        "quill": "2.0.3",
        "rxjs": "~7.8.2",
        "sass": "^1.104.0",
        "shiki": "^4.4.3",
        "tslib": "^2.8.1",
        "typedoc": "0.28.20",
        "vite": "^8.3.0",
        "vite-tsconfig-paths": "^6.1.1"
    }
