{
    "name": "@openng/optimus-ui-monorepo",
    "version": "3.0.0",
    "author": "OpenNG",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/openng-org/optimus-ui.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/openng-org/optimus-ui/issues"
    },
    "scripts": {
        "clean": "rimraf --glob \"**/node_modules\" \"**/dist\" \"**/.angular\"",
        "link": "pnpm --filter './packages/*' dev:link",
        "release": "pnpm run build && pnpm recursive publish --filter './packages/*' --publish-branch main --report-summary",
        "release:beta": "pnpm run build && pnpm recursive publish --filter './packages/*' --publish-branch main --report-summary --tag beta",
        "release:rc": "pnpm run build && pnpm recursive publish --filter './packages/*' --publish-branch main --report-summary --tag rc",
        "build": "cross-env NODE_ENV=production pnpm run build:check && pnpm run build:packages",
        "build:check": "pnpm run format:check && pnpm run security:check",
        "build:packages": "pnpm run build:optimus-ui && pnpm run build:lib && pnpm run build:themes && pnpm run build:docs:content && pnpm run build:docs",
        "build:optimus-ui": "pnpm --filter './packages/optimus-ui-*' build",
        "build:lib": "pnpm --filter @openng/optimus-ui build",
        "build:themes": "pnpm --filter @openng/optimus-ui-themes build",
        "build:docs": "pnpm --filter docs build",
        "build:docs:content": "pnpm --filter docs build:docs",
        "dev": "pnpm --filter docs start",
        "dev:ssr": "pnpm --filter docs start:ssr",
        "security:check": "pnpm audit --prod --audit-level high",
        "format": "prettier --write \"packages/**/*.{js,mjs,ts,mts,d.ts,html}\" \"apps/**/*.{js,mjs,ts,mts,d.ts,html}\" \"scripts/**/*.{js,mjs,ts,mts}\" \"*.{js,mjs,ts,mts}\" --cache",
        "format:check": "prettier --check \"packages/**/*.{js,mjs,ts,mts,d.ts,html}\" \"apps/**/*.{js,mjs,ts,mts,d.ts,html}\" \"scripts/**/*.{js,mjs,ts,mts}\" \"*.{js,mjs,ts,mts}\"",
        "lint": "eslint packages apps --cache",
        "lint:fix": "eslint packages apps --fix",
        "test:unit": "pnpm run build:optimus-ui && pnpm --filter @openng/optimus-ui test:unit",
        "test:coverage": "pnpm run build:optimus-ui && pnpm --filter @openng/optimus-ui test:unit:coverage",
        "test:styled": "pnpm --filter @openng/optimus-ui-utils build && pnpm --filter @openng/optimus-ui-styled test"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "catalog:angular22",
        "@angular-eslint/eslint-plugin": "catalog:angular22",
        "@angular-eslint/eslint-plugin-template": "catalog:angular22",
        "@angular-eslint/schematics": "catalog:angular22",
        "@angular-eslint/template-parser": "catalog:angular22",
        "@angular/animations": "catalog:angular22",
        "@angular/cdk": "catalog:angular22",
        "@angular/cli": "catalog:angular22",
        "@angular/common": "catalog:angular22",
        "@angular/compiler": "catalog:angular22",
        "@angular/compiler-cli": "catalog:angular22",
        "@angular/core": "catalog:angular22",
        "@angular/forms": "catalog:angular22",
        "@angular/platform-browser": "catalog:angular22",
        "@angular/platform-browser-dynamic": "catalog:angular22",
        "@angular/platform-server": "catalog:angular22",
        "@angular/router": "catalog:angular22",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@openng/optimus-ui-motion": "workspace:*",
        "@openng/optimus-ui-styled": "workspace:*",
        "@openng/optimus-ui-styles": "workspace:*",
        "@openng/optimus-ui-themes": "workspace:*",
        "@openng/optimus-ui-utils": "workspace:*",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "cross-env": "catalog:",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "fs-extra": "catalog:",
        "glob": "catalog:",
        "globals": "^17.13.0",
        "lefthook": "^2.2.1",
        "ng-packagr": "catalog:angular22",
        "prettier": "catalog:",
        "rimraf": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:angular22"
    },
    "publishConfig": {
        "access": "public"
    },
    "packageManager": "pnpm@12.11.2",
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
    }
}
